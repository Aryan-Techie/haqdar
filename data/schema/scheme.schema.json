{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haqdar.example/schema/scheme.schema.json",
  "title": "Haqdar scheme record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "level", "states", "benefit", "benefit_weight", "description", "eligibility", "eligibility_plain", "documents", "how_to_apply", "apply_url", "source_url", "deadline", "last_verified", "rule_version", "verification"],
  "$defs": {
    "text": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {"en": {"type": "string", "minLength": 1}, "hi": {"type": "string", "minLength": 1}}
    },
    "textList": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "hi": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op"],
      "properties": {
        "field": {"enum": ["age", "gender", "occupation", "annual_income", "category", "marital_status", "land_acres", "disability", "student_level", "residence", "bpl", "pregnant_or_new_mother", "girl_child_under_10"]},
        "op": {"enum": ["eq", "in", "gte", "lte", "between", "exists"]},
        "value": {}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "gte"}}, "required": ["op"]},
         "then": {"required": ["value"], "properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"op": {"const": "lte"}}, "required": ["op"]},
         "then": {"required": ["value"], "properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"op": {"const": "between"}}, "required": ["op"]},
         "then": {"required": ["value"], "properties": {"value": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}}},
        {"if": {"properties": {"op": {"const": "in"}}, "required": ["op"]},
         "then": {"required": ["value"], "properties": {"value": {"type": "array", "minItems": 1, "items": {"type": ["string", "number", "boolean"]}}}}},
        {"if": {"properties": {"op": {"const": "eq"}}, "required": ["op"]},
         "then": {"required": ["value"], "properties": {"value": {"type": ["string", "number", "boolean"]}}}},
        {"if": {"properties": {"op": {"const": "exists"}}, "required": ["op"]},
         "then": {"not": {"required": ["value"]}}}
      ]
    },
    "rule": {
      "oneOf": [
        {"$ref": "#/$defs/predicate"},
        {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}}},
        {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}}},
        {"type": "object", "additionalProperties": false, "required": ["not"], "properties": {"not": {"$ref": "#/$defs/rule"}}}
      ]
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"$ref": "#/$defs/text"},
    "category": {"enum": ["pension", "health", "education", "farm", "women"]},
    "level": {"enum": ["central", "state"]},
    "states": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(\\*|[A-Z]{2})$"}},
    "benefit": {"$ref": "#/$defs/text"},
    "benefit_weight": {"type": "number", "minimum": 0, "maximum": 100},
    "description": {"$ref": "#/$defs/text"},
    "eligibility": {"$ref": "#/$defs/rule"},
    "eligibility_plain": {"$ref": "#/$defs/textList"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {"name": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"}, "note": {"$ref": "#/$defs/text"}}
      }
    },
    "how_to_apply": {"$ref": "#/$defs/textList"},
    "apply_url": {"type": ["string", "null"], "format": "uri"},
    "source_url": {"type": "string", "format": "uri"},
    "deadline": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rule_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hi_reviewed"],
      "properties": {
        "status": {"enum": ["sourced", "hand_verified"]},
        "by": {"type": ["string", "null"]},
        "hi_reviewed": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
