# Copy to .env. Never commit .env.
# dev (default, demo OTP 123456) or production. Production REFUSES TO START without real
# HAQDAR_SECRET and HAQDAR_FERNET_KEY below, and forces the demo OTP off.
HAQDAR_ENV=dev
# Random string used to sign session tokens (openssl rand -hex 32).
HAQDAR_SECRET=change-me
# Fernet key that encrypts profiles at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HAQDAR_FERNET_KEY=
# Dev only: accept the demo OTP 123456 (ignored when HAQDAR_ENV=production).
HAQDAR_DEV_OTP=1
# Number of trusted reverse proxies in front of the API (docker-compose sets 1). 0 = use the socket peer.
HAQDAR_TRUSTED_PROXY_HOPS=0
# Database, data directory and rate limit (requests per minute per IP). Defaults shown.
HAQDAR_DATABASE_URL=sqlite:///./haqdar.db
# HAQDAR_DATA_DIR=
HAQDAR_RATE_LIMIT=120
# Where the web app proxies /api/* (baked in at web build time).
API_URL=http://localhost:8000
# Optional SLNG voice. Leave the key empty to use the browser voice only.
SLNG_API_KEY=
SLNG_BASE_URL=https://api.slng.ai
# SLNG_STT_MODEL=sarvam/saaras:v3
# SLNG_TTS_MODEL=sarvam/bulbul:v3
# "browser" (default) or "slng". Read at web build time.
NEXT_PUBLIC_VOICE_PROVIDER=browser
